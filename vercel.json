{
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ],
  "functions": {
    "api/index.js": {
      "includeFiles": "server/{db/migrations,seed/data}/**"
    }
  },
  "crons": [
    {
      "path": "/api/cron/tick",
      "schedule": "0 3 * * *"
    }
  ]
}
