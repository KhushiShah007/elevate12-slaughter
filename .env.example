# Copy to .env.local (git-ignored). Set the same names in Vercel project settings.
# Server-side only: never prefix these with VITE_. Every key is optional;
# without one, that feature uses seeded open data and says so in the UI.

# --- Database ---
# Empty locally = embedded Postgres (PGlite) in .data/pglite.
# Production: a Supabase or Neon connection string (required on Vercel).
DATABASE_URL=

# --- Auth ---
# Sessions are random tokens (only their hash is stored), so no signing secret is needed.
# While no email/SMS provider is connected, sign-in codes are shown on screen.
# Set to off once one is connected.
OTP_SHOW_CODE=on
# Google sign-in (optional)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Documents ---
# 32 random bytes, base64, used to encrypt uploaded documents and sign view links.
# Required in production (uploads are refused without it). Locally one is made in .data/.
# Make one: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Keep it safe: losing it makes stored documents unreadable.
DOCS_ENCRYPTION_KEY=

# --- AI assistant ---
# Grok (xAI) is preferred when set; otherwise Groq.
XAI_API_KEY=
XAI_MODEL=grok-3-mini
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# --- Flights and hotels (Phases 7-8) ---
# Amadeus Self-Service test keys: https://developers.amadeus.com
AMADEUS_CLIENT_ID=
AMADEUS_CLIENT_SECRET=
AMADEUS_ENV=test

# --- Places, maps and cost of living ---
GOOGLE_MAPS_API_KEY=
NUMBEO_API_KEY=

# --- Voice (speech to text / text to speech fallback) ---
DEEPGRAM_API_KEY=
OPENAI_API_KEY=

# --- Payments (always test mode) ---
# Without Razorpay keys a demo provider is used, signed with MOCK_PAYMENT_SECRET.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
MOCK_PAYMENT_SECRET=

# --- Outbound messages ---
# Nothing is really sent unless the provider key is set AND this is true.
# Otherwise every email/SMS/WhatsApp/push goes to the in-app Outbox as a dry run.
ALLOW_REAL_OUTBOUND=false
RESEND_API_KEY=
EMAIL_FROM=
INBOUND_EMAIL_SECRET=
INBOUND_EMAIL_DOMAIN=
MSG91_AUTH_KEY=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
FCM_SERVER_KEY=

# --- Local / testing only (do not set on Vercel) ---
# PGLITE_DIR=.data/pglite
# SEED_LIGHT=1
# MIGRATIONS_DIR=
